# PostgreSQL gerenciado (Neon/Supabase). Copie para .env.local e preencha.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Administração inicial. Use uma senha forte e exclusiva.
ADMIN_EMAIL="admin@seudominio.com.br"
ADMIN_PASSWORD="TROQUE_POR_UMA_SENHA_FORTE"
# Gere um segredo aleatório com pelo menos 32 caracteres.
ADMIN_SESSION_SECRET="TROQUE_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES"

# WhatsApp comercial da Pietra. Formato internacional com DDI.
NEXT_PUBLIC_WHATSAPP_NUMBER="5579991393001"

# Preencher nos ambientes de deploy, sem versionar segredos.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Token OAuth do Melhor Envio, emitido pela conta da Pietra. Use sandbox para testes.
MELHORENVIO_TOKEN=""
MELHORENVIO_ENV="sandbox"
# CEP de origem do remetente cadastrado no Melhor Envio, com 8 dígitos.
MELHORENVIO_ORIGIN_POSTAL_CODE="49055690"
# IDs de serviços liberados, separados por vírgula; vazio permite os serviços da conta.
MELHORENVIO_SERVICE_IDS=""
# E-mail de suporte usado no User-Agent obrigatório da API do Melhor Envio.
MELHORENVIO_SUPPORT_EMAIL=""
SHIPPING_QUOTE_SECRET="GERE_UM_SEGREDO_ALEATORIO_COM_32_CARACTERES_OU_MAIS"
CRON_SECRET="GERE_OUTRO_SEGREDO_ALEATORIO_COM_32_CARACTERES_OU_MAIS"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
